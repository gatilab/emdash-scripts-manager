{
	"name": "@gatilab/emdash-scripts-manager",
	"version": "0.1.0",
	"description": "Per-entry and site-wide code for EmDash: custom CSS, JavaScript, raw head HTML and footer HTML on any content entry, plus global head, body-start and footer code, emitted in a fixed order by drop-in Astro components. Admin-only editing. Port of the Marketers Delight Scripts Manager drop-in.",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./core": "./src/core/index.ts",
		"./astro": "./src/astro/index.ts",
		"./site": "./src/site/index.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"wordpress",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"sideEffects": [
		"**/*.astro"
	],
	"keywords": [
		"emdash",
		"emdash-plugin",
		"astro",
		"scripts",
		"custom-css",
		"custom-javascript",
		"header-footer-code",
		"tracking-scripts",
		"code-snippets"
	],
	"author": "Gatilab (https://gatilab.com)",
	"license": "MIT",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && astro check --root . --tsconfig ./tsconfig.json",
		"prepublishOnly": "pnpm typecheck && pnpm test"
	},
	"peerDependencies": {
		"astro": "^7.0.0",
		"emdash": "^1.4.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@emdash-cms/blocks": "1.4.0",
		"@types/node": "^24.0.0",
		"astro": "^7.3.2",
		"emdash": "^1.4.0",
		"typescript": "^6.0.3",
		"vitest": "4.1.10"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gatilab/emdash-scripts-manager.git"
	},
	"homepage": "https://github.com/gatilab/emdash-scripts-manager#readme",
	"bugs": {
		"url": "https://github.com/gatilab/emdash-scripts-manager/issues"
	},
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
